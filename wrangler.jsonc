{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "florilegium-librarium",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*"]
  },
  "r2_buckets": [
    {
      "binding": "LIBRARY_BUCKET",
      "bucket_name": "sacrum-assets"
    }
  ],
  "vars": {
    "R2_PREFIX": "pdfs/",
    "R2_PUBLIC_BASE_URL": "https://assets.sacrumflorilegium.com/",
    "PDFJS_BASE_URL": "https://reader.sacrumflorilegium.com/web/viewer.html",
    "AIRTABLE_BASE_ID": "appEBrDjSYL5WYWft",
    "AIRTABLE_BOOKS_TABLE": "Books",
    "AIRTABLE_AUTHORS_TABLE": "Authors",
    "AIRTABLE_CLASSIFICATIONS_TABLE": "Classifications"
  },
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    }
  }
}
